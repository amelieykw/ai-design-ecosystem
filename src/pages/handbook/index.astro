---
import { getCollection } from 'astro:content'
import ToolCard from '@/components/handbook/ToolCard.astro'
import Header from '@/components/nav/Header.astro'
import Footer from '@/components/nav/Footer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const tools = await getCollection('handbook')
const sorted = tools.sort((a, b) => a.data.title.localeCompare(b.data.title))
---

<BaseLayout title="目录手册 · AI 设计生态仓库">
	<Header />
	<!-- page-header 是页面级标题(与站级 Header 两层);back 箭头已移除——logo 即回首页入口,不再重复 -->
	<header class="page-header container">
		<h1>目录手册</h1>
		<span class="count">{tools.length} 个工具</span>
	</header>
	<main class="tool-grid container">
		{sorted.map((tool) => <ToolCard tool={tool} />)}
	</main>
	<Footer />
</BaseLayout>

<style>
/* 批 3 收口:max-width/margin/左右 padding 用 .container 工具类,
   上下 padding 由本组件专属规则提供 */
.page-header {
	padding-top: var(--space-8);
	padding-bottom: 0;
	display: flex;
	align-items: baseline;
	gap: var(--space-4);
}
.page-header h1 {
	font-size: var(--font-h3);
}
.count {
	font-size: var(--font-small);
	color: var(--color-text-secondary);
}
.tool-grid {
	padding-top: var(--space-8);
	padding-bottom: var(--space-8);
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
	gap: var(--space-4);
}
</style>
