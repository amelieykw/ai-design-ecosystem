---
import { getCollection, render } from 'astro:content'
import DocLayout from '@/layouts/DocLayout.astro'
import { TOOL_STATUS_COLORS, type ToolStatus } from '@/lib/status'

export async function getStaticPaths() {
	const tools = await getCollection('handbook')
	// schema 已是 z.string() 受控,regex 是冗余防御;触发即数据 bug,直接抛错阻断 build
	// (异常前缀 [handbook] 便于排查;后续 assets-* 详情页套同一模式时改成 [<collection>])
	const SLUG_RE = /^[a-z0-9]+(-[a-z0-9]+)*$/
	return tools.map((tool) => {
		if (!SLUG_RE.test(tool.id)) {
			throw new Error(`[handbook] 不合规 id 阻断 build: ${tool.id}(需 kebab-case)`)
		}
		return {
			params: { id: tool.id },
			props: { tool },
		}
	})
}

const { tool } = Astro.props
const { Content } = await render(tool)
const statusColor = TOOL_STATUS_COLORS[tool.data.status as ToolStatus]
---

<DocLayout
	title={tool.data.title}
	breadcrumb={[
		{ label: '首页', href: '/' },
		{ label: '目录手册', href: '/handbook/' },
		{ label: tool.data.title, href: '' },
	]}
>
	<header class="doc-header">
		<div class="meta-row">
			<span class="layer-badge">{tool.data.layer}</span>
			<span class="status-pill" style={`background: ${statusColor}`}>
				<span class="sr-only">状态:</span>{tool.data.status}
			</span>
			{tool.data.version && <span class="version">v{tool.data.version}</span>}
			{tool.data.stars && <span class="stars">★ {tool.data.stars}</span>}
		</div>
		<h1>{tool.data.title}</h1>
		<p class="purpose">{tool.data.purpose}</p>
	</header>

	{tool.data.install && (
		<section class="install-block" aria-label="安装命令">
			<h2>安装</h2>
			<pre><code>{tool.data.install}</code></pre>
		</section>
	)}

	<section class="doc-body" aria-label="详细教程">
		<Content />
	</section>

	<footer class="links-row">
		{tool.data.docs && <a href={tool.data.docs} target="_blank" rel="noopener noreferrer">文档 ↗</a>}
		{tool.data.repo && <a href={tool.data.repo} target="_blank" rel="noopener noreferrer">仓库 ↗</a>}
	</footer>
</DocLayout>

<style>
.doc-header {
	margin-bottom: var(--space-8);
}
.meta-row {
	display: flex;
	gap: var(--space-3);
	align-items: center;
	margin-bottom: var(--space-4);
	font-size: var(--font-small);
}
.layer-badge {
	color: var(--color-text-secondary);
}
.status-pill {
	color: var(--color-text-on-dark);
	padding: 2px var(--space-2);
	border-radius: var(--radius-sm);
}
.version,
.stars {
	color: var(--color-text-secondary);
}
.doc-header h1 {
	font-size: var(--font-h1);
	margin-bottom: var(--space-4);
}
.purpose {
	font-size: var(--font-h4);
	color: var(--color-text-secondary);
	margin-bottom: 0;
}
.install-block {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
	padding: var(--space-4);
	margin-bottom: var(--space-8);
}
.install-block h2 {
	font-size: var(--font-h4);
	margin: 0 0 var(--space-3);
}
.install-block pre {
	margin: 0;
	background: transparent;
	border: none;
	padding: 0;
}
.links-row {
	display: flex;
	gap: var(--space-6);
	margin-top: var(--space-12);
	padding-top: var(--space-6);
	border-top: 1px solid var(--color-border);
}
.links-row a {
	color: var(--color-text-primary);
}
.sr-only {
	position: absolute;
	width: 1px;
	height: 1px;
	padding: 0;
	margin: -1px;
	overflow: hidden;
	clip: rect(0, 0, 0, 0);
	white-space: nowrap;
	border: 0;
}
</style>
