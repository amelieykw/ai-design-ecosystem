---
// 素材详情页:/assets/<subclass>/<id>/,套 V1.0 通用 DocLayout(含站级 Header/Footer)
// 主展示区按子类"存在才渲染"(渐进补全契约):colors→Swatch 大色卡,components→代码块,
// styles→关联资产列表;无专属结构化数据时显示 V2 占位,正文 md 始终渲染
import { getCollection, render } from 'astro:content'
import DocLayout from '@/layouts/DocLayout.astro'
import ColorView from '@/components/assets/ColorView.astro'
import FontView from '@/components/assets/FontView.astro'
import LayoutView from '@/components/assets/LayoutView.astro'
import MotionView from '@/components/assets/MotionView.astro'
import TextureView from '@/components/assets/TextureView.astro'
import PromptView from '@/components/assets/PromptView.astro'
import { SUBCLASSES, collectionOf } from '@/lib/assets'
import { hasShowcase } from '@/lib/showcase'

export async function getStaticPaths() {
	// 双层展开:SUBCLASSES × 各自 collection 条目。集合为空(填数据前,Task 24)时
	// 对应子类产出 0 条路径 —— 8 集合全空则本路由整体 0 页,build 页数不变,属预期
	const SLUG_RE = /^[a-z0-9]+(-[a-z0-9]+)*$/
	const grouped = await Promise.all(
		SUBCLASSES.map(async (sc) => {
			const entries = await getCollection(collectionOf(sc))
			return entries.map((entry) => {
				// 同 handbook/[id].astro:id 由文件名决定,regex 是数据 bug 防御,
				// 触发即抛错阻断 build;前缀带 collection 便于定位是哪个子类的条目
				if (!SLUG_RE.test(entry.id)) {
					throw new Error(`[${collectionOf(sc)}] 不合规 id 阻断 build: ${entry.id}(需 kebab-case)`)
				}
				return {
					params: { subclass: sc.key, id: entry.id },
					props: { sc, entry },
				}
			})
		})
	)
	return grouped.flat()
}

const { sc, entry } = Astro.props
const { Content } = await render(entry)

// 子类专属结构化字段:8 个集合 schema 各异,entry.data 是 union,
// 用 'in' 守卫按字段名收窄(各字段仅在对应子类声明,余同理),禁手写 any
// hasShowcase 由 showcase.ts 提供(单一事实源,8 个谓词 + 聚合)
const palette = 'palette' in entry.data ? entry.data.palette : undefined
const pairing = 'pairing' in entry.data ? entry.data.pairing : undefined
const typeScale = 'typeScale' in entry.data ? entry.data.typeScale : undefined
const grid = 'grid' in entry.data ? entry.data.grid : undefined
const curves = 'curves' in entry.data ? entry.data.curves : undefined
const durations = 'durations' in entry.data ? entry.data.durations : undefined
const patterns = 'patterns' in entry.data ? entry.data.patterns : undefined
const references = 'references' in entry.data ? entry.data.references : undefined
const linkedAssets = 'linkedAssets' in entry.data ? entry.data.linkedAssets : undefined
const level = 'level' in entry.data ? entry.data.level : undefined
const code = 'code' in entry.data ? entry.data.code : undefined
const preview = 'preview' in entry.data ? entry.data.preview : undefined
const prompt = 'prompt' in entry.data ? entry.data.prompt : undefined
const model = 'model' in entry.data ? entry.data.model : undefined
const negative = 'negative' in entry.data ? entry.data.negative : undefined
---

<DocLayout
	title={`${entry.data.title} · ${sc.name} · 灵感资产库`}
	breadcrumb={[
		{ label: '首页', href: '/' },
		{ label: '灵感库', href: '/assets/' },
		{ label: sc.name, href: `/assets/${sc.key}/` },
		{ label: entry.data.title },
	]}
>
	<header class="doc-header">
		<div class="meta-row">
			<span class="subclass-badge">{sc.name}</span>
			<span class="asset-tags">
				{entry.data.tags.slice(0, 3).map((t) => <span class="tag">#{t}</span>)}
			</span>
			<time class="added-at" datetime={entry.data.addedAt}>{entry.data.addedAt}</time>
		</div>
		<h1>{entry.data.title}</h1>
		<p class="desc">{entry.data.description}</p>
	</header>

	<section class="showcase" aria-label="素材展示区">
		{palette && palette.length > 0 && (
			<ColorView palette={palette} />
		)}
		{pairing && pairing.length > 0 && (
			<FontView pairing={pairing} />
		)}
		{(typeScale && typeScale.length > 0) || grid ? (
			<LayoutView typeScale={typeScale} grid={grid} />
		) : null}
		{(curves && curves.length > 0) || durations ? (
			<MotionView curves={curves} durations={durations} />
		) : null}
		{patterns && patterns.length > 0 && (
			<TextureView patterns={patterns} />
		)}
		{/* styles 内联:references(url 列表)+ linkedAssets(契约 "key/slug" 纯文本列表);
		    跨素材链接需 refine 校验后再变链接(Task 14 处理,此处不 fabricated 链接防 404) */}
		{((references && references.length > 0) ||
			(linkedAssets && linkedAssets.length > 0)) && (
			<section class="styles-block" aria-labelledby="styles-heading">
				<h2 id="styles-heading" class="block-heading">风格参考</h2>
				{references && references.length > 0 && (
					<div class="styles-refs">
						<h3>外部参考</h3>
						<ul>
							{references.map((url) => (
								<li>
									<a
										href={url}
										target="_blank"
										rel="noopener noreferrer external"
									>
										{url}
									</a>
								</li>
							))}
						</ul>
					</div>
				)}
				{linkedAssets && linkedAssets.length > 0 && (
					<div class="styles-linked">
						<h3>关联资产</h3>
						{/* 契约 "key/slug":V2 升级为 refine 后才能解析为 /assets/<key>/<slug>/ 链接,
						    当前仅做文本展示,避免 dangling reference 拼成 404 链接 */}
						<ul>
							{linkedAssets.map((ref) => <li>{ref}</li>)}
						</ul>
					</div>
				)}
			</section>
		)}
		{/* components 内联:level 徽章 + code(pre/code,样式由 DocLayout .doc :global 接管)
		    + preview(可选图片)。无独立组件——结构轻量、内联更易读 */}
		{level && (
			<section class="components-block" aria-labelledby="components-heading">
				<div class="components-head">
					<h2 id="components-heading" class="block-heading">配件</h2>
					<span class="level-badge">{level}</span>
				</div>
				{code && code.length > 0 && (
					<pre class="code-block"><code>{code}</code></pre>
				)}
				{preview && (
					<p class="components-preview">
						<img src={preview} alt={`${entry.data.title} 预览`} loading="lazy" />
					</p>
				)}
			</section>
		)}
		{prompt && model && (
			<PromptView prompt={prompt} model={model} negative={negative} />
		)}
		{!hasShowcase(entry.data) && <p class="placeholder">该子类专属展示 V2 上线。</p>}
	</section>

	<section class="doc-body" aria-label="正文">
		<Content />
	</section>

	<footer class="tags-row" aria-label="标签">
		{entry.data.tags.map((t) => <span class="tag">#{t}</span>)}
	</footer>
</DocLayout>

<style>
.doc-header {
	margin-bottom: var(--space-8);
}
.meta-row {
	display: flex;
	gap: var(--space-3);
	align-items: center;
	margin-bottom: var(--space-4);
	font-size: var(--font-small);
	flex-wrap: wrap;
}
.subclass-badge {
	color: var(--color-text-on-dark);
	background: var(--color-text-primary);
	padding: 2px var(--space-2);
	border-radius: var(--radius-sm);
}
.asset-tags {
	display: flex;
	gap: var(--space-2);
	flex-wrap: wrap;
}
.tag {
	color: var(--color-text-secondary);
}
.added-at {
	color: var(--color-text-secondary);
}
.doc-header h1 {
	font-size: var(--font-h1);
	margin-bottom: var(--space-4);
}
.desc {
	font-size: var(--font-h4);
	color: var(--color-text-secondary);
	margin-bottom: 0;
}
/* 主展示区:与 header、正文间各留一档间距 */
.showcase {
	margin-bottom: var(--space-8);
}
.code-block {
	margin: 0;
}
/* pre 默认样式由 DocLayout .doc :global(pre) 提供,此处仅去多余底边距 */
.showcase :global(pre.code-block) {
	margin-bottom: 0;
}
/* styles 子类内联块:references + linkedAssets 两栏标题 + 列 */
.block-heading {
	font-size: var(--font-h4);
	font-weight: 600;
	margin: 0 0 var(--space-3);
	color: var(--color-text-primary);
}
.styles-block,
.components-block {
	margin-bottom: var(--space-6);
}
.styles-block h3 {
	font-size: var(--font-body);
	font-weight: 600;
	margin: var(--space-3) 0 var(--space-2);
	color: var(--color-text-secondary);
}
.styles-block ul {
	padding-left: var(--space-6);
	margin: 0;
}
.styles-block li {
	margin-bottom: var(--space-2);
	line-height: 1.6;
	overflow-wrap: anywhere;
}
/* components 内联块:level 徽章与标题同行,右对齐 */
.components-head {
	display: flex;
	align-items: baseline;
	gap: var(--space-3);
	margin-bottom: var(--space-3);
}
.level-badge {
	font-family: var(--font-mono);
	font-size: var(--font-small);
	color: var(--color-text-on-dark);
	background: var(--color-text-primary);
	padding: 2px var(--space-2);
	border-radius: var(--radius-sm);
}
.components-preview {
	margin: var(--space-3) 0 0;
}
.components-preview img {
	max-width: 100%;
	border: 1px solid var(--color-border);
	border-radius: var(--radius-md);
}
.placeholder {
	color: var(--color-text-secondary);
	font-size: var(--font-body);
	border: 1px dashed var(--color-border);
	border-radius: var(--radius-md);
	padding: var(--space-6);
	margin: 0;
	background: var(--color-surface);
}
.doc-body {
	margin-bottom: var(--space-8);
}
/* 正文 md 由 ## 起步,标题/段落/pre 样式由 DocLayout .doc :global(...) 提供 */
.tags-row {
	display: flex;
	gap: var(--space-3);
	flex-wrap: wrap;
	margin-top: var(--space-12);
	padding-top: var(--space-6);
	border-top: 1px solid var(--color-border);
}
</style>
