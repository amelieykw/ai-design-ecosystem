---
import SixLayerMap from '@/components/home/SixLayerMap.astro'
import EntryCards from '@/components/home/EntryCards.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="AI 设计生态仓库">
	<header class="site-header">
		<h1>AI 设计生态仓库</h1>
		<nav aria-label="主导航">
			<a href="/handbook/">目录手册</a>
			<a href="/workflow/">工作流</a>
			<a href="/cheatsheet/">速查</a>
			<a href="/assets/">灵感库</a>
		</nav>
	</header>

	<main>
		<p class="tagline">「Skill 教 AI 方法,DESIGN.md 告诉 AI 目标」</p>

		<EntryCards />
		<SixLayerMap />
	</main>
</BaseLayout>

<style>
.site-header {
	padding: var(--space-6) var(--space-8);
	display: flex;
	justify-content: space-between;
	align-items: center;
	border-bottom: 1px solid var(--color-border);
}
.site-header h1 {
	font-size: var(--font-h3);
}
.site-header nav {
	display: flex;
	gap: var(--space-6);
}
.site-header nav a {
	text-decoration: none;
	color: var(--color-text-primary);
	font-size: var(--font-body);
}
main {
	padding: var(--space-8);
	max-width: var(--container-max);
	margin: 0 auto;
}
.tagline {
	font-family: var(--font-serif);
	font-size: var(--font-h2);
	margin: var(--space-12) 0 var(--space-8);
}
</style>