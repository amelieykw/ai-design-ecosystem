---
import SixLayerMap from '@/components/home/SixLayerMap.astro'
import EntryCards from '@/components/home/EntryCards.astro'
import Header from '@/components/nav/Header.astro'
import Footer from '@/components/nav/Footer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="AI 设计生态仓库">
	<Header logoHeading />

	<main class="container">
		<p class="tagline">「Skill 教 AI 方法,DESIGN.md 告诉 AI 目标」</p>

		<EntryCards />
		<SixLayerMap />
	</main>

	<Footer />
</BaseLayout>

<style>
/* 批 3 收口:max-width/margin/左右 padding 用 .container 工具类,
   上下 padding 由本组件专属 main 规则提供 */
main {
	padding-top: var(--space-8);
	padding-bottom: var(--space-8);
}
.tagline {
	font-family: var(--font-serif);
	font-size: var(--font-h2);
	margin: var(--space-12) 0 var(--space-8);
}
</style>
