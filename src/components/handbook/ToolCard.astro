---
// 工具卡片:handbook 列表的数据驱动卡片
// 状态圆点颜色经 getToolStatusColor 映射到 token(单一事实源在 src/lib/status)
import { getToolStatusColor } from '@/lib/status'
const { tool } = Astro.props

const statusColor = getToolStatusColor(tool.data.status)
---

<a href={`/handbook/${tool.id}/`} class="tool-card card-link">
  <div class="tool-meta">
    <span class="layer-badge">{tool.data.layer}</span>
    <span class="status-dot" style={`background: ${statusColor}`} aria-hidden="true"></span>
    <span class="sr-only">{tool.data.status}</span>
  </div>
  <h3 class="tool-name">{tool.data.title}</h3>
  <div class="tool-purpose">{tool.data.purpose}</div>
  <div class="tool-tags">
    {tool.data.tags.slice(0, 3).map((t: string) => <span class="tag">#{t}</span>)}
    {tool.data.tags.length > 3 && <span class="tag">+{tool.data.tags.length - 3}</span>}
  </div>
</a>

<style>
/* 卡片基础(border/surface/hover+focus/transition)来自 global.css 的 .card-link,此处只留特有样式 */
.tool-card {
  padding: var(--space-4);
}
.tool-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-2);
}
.layer-badge {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}
.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}
.tool-name {
  font-family: var(--font-serif);
  font-size: var(--font-h4);
  margin-bottom: var(--space-2);
}
.tool-purpose {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-3);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tool-tags {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}
.tag {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}
</style>
