---
// 首页 4 入口大卡:主卡 2x + 副卡 1x × 3(违反三卡片等宽禁令的反例)
// 数据静态;数量徽章后续接 collection 后再接真实数字
const entries = [
  { title: '目录手册', desc: '30+ 工具', href: '/handbook/', primary: true },
  { title: '工作流', desc: '四步法', href: '/workflow/' },
  { title: '速查', desc: '常用命令一屏速查', href: '/cheatsheet/' },
  { title: '灵感库', desc: '8 类素材', href: '/assets/' },
]
---

<section class="entries" aria-label="站级四大模块入口">
  {entries.map((entry) => (
    <a href={entry.href} class={`entry-card card-link ${entry.primary ? 'primary' : ''}`}>
      <div class="entry-title">{entry.title}</div>
      <div class="entry-desc">{entry.desc}</div>
    </a>
  ))}
</section>

<style>
/* 卡片基础(border/surface/hover+focus/transition)来自 global.css 的 .card-link,此处只留特有样式 */
.entries {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: var(--space-4);
  margin-top: var(--space-12);
}
.entry-card {
  padding: var(--space-6);
  min-height: 140px;
}
.entry-card.primary {
  background: var(--color-bg-dark);
  color: var(--color-text-on-dark);
  border-color: var(--color-bg-dark);
}
.entry-title {
  font-family: var(--font-serif);
  font-size: var(--font-h3);
  margin-bottom: var(--space-2);
}
.entry-desc {
  font-size: var(--font-body);
  opacity: 0.7;
}
@media (max-width: 1024px) {
  .entries { grid-template-columns: 1fr 1fr; }
  .entry-card.primary { grid-column: span 2; }
}
@media (max-width: 640px) {
  .entries { grid-template-columns: 1fr; }
  .entry-card.primary { grid-column: span 1; }
}
</style>
