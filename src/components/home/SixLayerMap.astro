---
// 六层全景图:内容源文档 §一 的架构分层,静态数据(层数 ≠ 工具条目数)。
// 层枚举与 content.config.ts 的 schema 共用 src/lib/layers.ts 单一事实源
import { LAYERS } from '@/lib/layers'
import { withBase } from '@/lib/base'
---

<section class="layers" aria-label="AI 设计生态六层架构">
  {LAYERS.map((layer) => (
    <a href={withBase(`/handbook/?layer=${encodeURIComponent(layer.id)}`)} class="layer-card card-link">
      <div class="layer-id">{layer.id}</div>
      <div class="layer-desc">{layer.desc}</div>
    </a>
  ))}
</section>

<style>
/* 卡片基础(border/surface/hover+focus/transition)来自 global.css 的 .card-link,此处只留特有样式 */
.layers {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--space-3);
}
.layer-card {
  padding: var(--space-4);
}
.layer-id {
  font-family: var(--font-serif);
  font-size: var(--font-h3);
  margin-bottom: var(--space-2);
}
.layer-desc {
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}
@media (max-width: 1024px) {
  .layers { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 640px) {
  .layers { grid-template-columns: 1fr; }
}
</style>
