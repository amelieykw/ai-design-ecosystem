---
// 站级极简 Footer:站名 + 仓库链接 + 工作流狗粮展示位(验收项 G:
// 本站自身即「DESIGN.md → tokens.css → 组件」工作流产出的范例,页脚明示)
const REPO_URL = 'https://github.com/amelieykw/ai-design-ecosystem'
---

<footer class="site-footer divider-top">
  <div class="footer-inner container">
    <span class="site-name">AI 设计生态仓库</span>
    <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
    <span class="powered">
      Powered by <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
      · DESIGN.md 工作流范例
    </span>
  </div>
</footer>

<style>
/* 批 3 收口:border-top 改用 .divider-top 工具类;max-width/margin/左右 padding
   用 .container 工具类(见 global.css utilities 层),仅留上下 padding/flex/字号 */
.site-footer {
  margin-top: var(--space-8);
}
.footer-inner {
  padding-top: var(--space-6);
  padding-bottom: var(--space-6);
  display: flex;
  gap: var(--space-6);
  align-items: center;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}
.footer-inner a {
  color: var(--color-text-secondary);
  text-decoration: none;
}
.footer-inner a:hover,
.footer-inner a:focus-visible {
  color: var(--color-text-primary);
  text-decoration: underline;
}
.powered {
  margin-left: auto;
}
@media (max-width: 640px) {
  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .powered {
    margin-left: 0;
  }
}
</style>
