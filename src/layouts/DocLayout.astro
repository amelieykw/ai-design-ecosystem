---
// 详情页布局:站级 Header + 面包屑 + 正文容器(md 渲染)+ 站级 Footer
// 面包屑实现已抽取为 Breadcrumb.astro 共用组件(V1.1 Task 14,assets 瀑布页同用)
interface Props {
	title: string
	breadcrumb: { label: string; href?: string }[]
}
const { title, breadcrumb } = Astro.props
import BaseLayout from './BaseLayout.astro'
import Header from '@/components/nav/Header.astro'
import Footer from '@/components/nav/Footer.astro'
import Breadcrumb from '@/components/nav/Breadcrumb.astro'
---

<BaseLayout title={`${title} · AI 设计生态仓库`}>
	<Header />
	<Breadcrumb items={breadcrumb} />
	<article class="doc">
		<slot />
	</article>
	<Footer />
</BaseLayout>

<style>
/* .doc 走 800px 阅读宽度(比 --container-max 略窄,长文更易读),不用 .container */
.doc {
	max-width: 800px;
	margin: 0 auto;
	padding: var(--space-8);
}
/* ⚠️ 不推荐样本作者用 <h1>:页面侧 .doc-header h1 已提供主标题;md 内容应从 <h2> 起步
   此规则仅做防御:若作者误写 <h1>,视觉降级到 h2 字号,避免双重放大。
   DOM 仍是 h1,SR 仍按 h1 播报;但视觉权重不致过大。 */
.doc :global(h1) {
	font-size: var(--font-h2);
}
.doc :global(h2) {
	font-size: var(--font-h2);
	margin: var(--space-8) 0 var(--space-4);
}
.doc :global(p) {
	margin-bottom: var(--space-4);
	line-height: 1.8;
}
.doc :global(pre) {
	background: var(--color-surface);
	border: 1px solid var(--color-border);
	padding: var(--space-4);
	border-radius: var(--radius-md);
	overflow-x: auto;
	margin-bottom: var(--space-4);
}
.doc :global(ul),
.doc :global(ol) {
	padding-left: var(--space-6);
	margin-bottom: var(--space-4);
}
.doc :global(li) {
	margin-bottom: var(--space-2);
	line-height: 1.8;
}
</style>
